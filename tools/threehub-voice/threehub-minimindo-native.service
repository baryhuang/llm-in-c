[Unit]
Description=ThreeHub native MiniMind-O speech-to-speech
After=sound.target
Conflicts=threehub-voice-assistant.service

[Service]
Type=simple
ExecStartPre=-/usr/bin/amixer -c 0 set Mic 50% cap
ExecStartPre=-/usr/bin/amixer -c 0 set PCM 5% unmute
ExecStart=/usr/local/bin/run-minimindo-native-a113x.sh
ExecStopPost=-/usr/local/bin/supervisor led sys_event_off
ExecStopPost=-/usr/local/bin/supervisor led wifi_config_stopped
ExecStopPost=-/usr/local/bin/supervisor led clear
Restart=always
RestartSec=30
Nice=-5
OOMScoreAdjust=-500

[Install]
WantedBy=multi-user.target
